// Emits the declarations published with client (`bun run build`), against
// core's published declarations rather than its source.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {},
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src"]
}
