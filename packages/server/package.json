{
  "name": "@ticknet/server",
  "version": "0.0.2",
  "description": "The Server side of ticknet, a UDP transport for real-time Bun games.",
  "license": "MIT",
  "keywords": [
    "bun",
    "udp",
    "netcode",
    "multiplayer",
    "game-networking",
    "realtime",
    "transport",
    "reliable-udp",
    "gamedev"
  ],
  "homepage": "https://github.com/Popoch39/ticknet#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Popoch39/ticknet.git",
    "directory": "packages/server"
  },
  "bugs": "https://github.com/Popoch39/ticknet/issues",
  "type": "module",
  "scripts": {
    "prepack": "bun ../../scripts/build.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@ticknet/core": "workspace:*"
  },
  "devDependencies": {
    "@ticknet/client": "workspace:*"
  }
}
