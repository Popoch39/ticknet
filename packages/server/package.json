{
  "name": "@ticknet/server",
  "version": "0.0.1",
  "description": "The Server side of ticknet, a UDP transport for real-time Bun games.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepack": "bun ../../scripts/build.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@ticknet/core": "workspace:*"
  },
  "devDependencies": {
    "@ticknet/client": "workspace:*"
  }
}
